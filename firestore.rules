rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       AUTH
    ===================================================== */

    function signedIn() {

      return request.auth != null;

    }


    /* =====================================================
       ADMIN HELPERS
    ===================================================== */

    function isAdmin() {

      return signedIn()

        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;

    }


    function adminRole() {

      return isAdmin()

        ? get(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          ).data.role

        : "";

    }


    function isReviewer() {

      return isAdmin()

        && (
          adminRole() == "reviewer" ||
          adminRole() == "content_admin" ||
          adminRole() == "superadmin"
        );

    }


    function isContentAdmin() {

      return isAdmin()

        && (
          adminRole() == "content_admin" ||
          adminRole() == "superadmin"
        );

    }


    function isSuperAdmin() {

      return isAdmin()

        && adminRole() == "superadmin";

    }


    /* =====================================================
       ADMINS
    ===================================================== */

    match /admins/{uid} {

      allow get: if signedIn()
                 && (
                   request.auth.uid == uid ||
                   isSuperAdmin()
                 );


      allow list: if isSuperAdmin();


      allow create: if isSuperAdmin();


      allow update: if isSuperAdmin();


      allow delete: if false;

    }


    /* =====================================================
       BRANCHES
    ===================================================== */

    match /branches/{branchId} {

      /*
       * الموقع وجميع المستخدمين يستطيعون قراءة الفروع.
       */
      allow read: if true;


      /*
       * إنشاء فرع:
       * Super Admin فقط.
       */
      allow create: if isSuperAdmin();


      /*
       * تعديل فرع:
       * Super Admin فقط.
       */
      allow update: if isSuperAdmin();


      /*
       * لا نحذف الفروع.
       *
       * بدل الحذف:
       * active: false
       */
      allow delete: if false;

    }


    /* =====================================================
       SUBJECTS
    ===================================================== */

    match /subjects/{subjectId} {

      allow read: if true;

      allow create, update, delete:
        if isContentAdmin();

    }


    /* =====================================================
       RESOURCES
    ===================================================== */

    match /resources/{resourceId} {

      allow read: if true;

      allow create, update, delete:
        if isContentAdmin();

    }


    /* =====================================================
       FOUNDATIONS
    ===================================================== */

    match /foundations/{foundationId} {

      allow read: if true;

      allow create, update, delete:
        if isContentAdmin();

    }


    /* =====================================================
       SUGGESTIONS
    ===================================================== */

    match /suggestions/{suggestionId} {

      allow create: if true;


      allow read: if isReviewer();


      allow update: if isReviewer();


      allow delete: if false;

    }


    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {

      allow read, write: if false;

    }

  }

} match /suggestions/{suggestionId} {

      /*
       * الطلاب يستطيعون إنشاء اقتراح.
       */
      allow create: if true;


      /*
       * Reviewer وما فوق.
       */
      allow read: if isReviewer();


      /*
       * Reviewer وما فوق يستطيع مراجعة الاقتراح.
       */
      allow update: if isReviewer();


      /*
       * لا نحذف الاقتراحات.
       */
      allow delete: if false;
    }


    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}