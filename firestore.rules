rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function adminRole() {
      return isAdmin()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : "";
    }

    function isReviewer() {
      return isAdmin() && (adminRole() == "reviewer" || adminRole() == "content_admin" || adminRole() == "superadmin" || adminRole() == "super_admin" || adminRole() == "admin");
    }

    function isContentAdmin() {
      return isAdmin() && (adminRole() == "content_admin" || adminRole() == "superadmin" || adminRole() == "super_admin" || adminRole() == "admin");
    }

    function isSuperAdmin() {
      return isAdmin() && (adminRole() == "superadmin" || adminRole() == "super_admin" || adminRole() == "admin");
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();
    }

    match /foundations/{foundationId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();
    }

    match /suggestions/{suggestionId} {
      allow create: if true;
      allow read, update: if isReviewer();
      allow delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /templates/{templateId} {
      allow read, create, update, delete: if isContentAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
