rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc(uid) { return /databases/$(database)/documents/admins/$(uid); }
    function activeAdmin() { return signedIn() && exists(adminDoc(request.auth.uid)) && get(adminDoc(request.auth.uid)).data.active == true; }
    function role() { return activeAdmin() ? get(adminDoc(request.auth.uid)).data.role : ''; }
    function reviewer() { return activeAdmin() && role() in ['reviewer','content_admin','super_admin','superadmin','admin']; }
    function contentAdmin() { return activeAdmin() && role() in ['content_admin','super_admin','superadmin','admin']; }
    function superAdmin() { return activeAdmin() && role() in ['super_admin','superadmin','admin']; }
    function canonicalRole() { return request.resource.data.role in ['reviewer','content_admin','super_admin']; }
    function validAdminWrite() { return request.resource.data.active is bool && request.resource.data.role is string && canonicalRole(); }
    function validStudentProfile() { return request.resource.data.keys().hasOnly(['name','email','role','identityNumber','createdAt','lastLoginAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.role == 'student' && (request.resource.data.identityNumber == null || (request.resource.data.identityNumber is string && request.resource.data.identityNumber.size() >= 4 && request.resource.data.identityNumber.size() <= 32)); }
    function validStudentProfileUpdate() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','identityNumber','lastLoginAt','updatedAt']) && request.resource.data.role == resource.data.role && request.resource.data.role == 'student' && request.resource.data.email == resource.data.email; }
    function validSet() { return request.resource.data.ownerId == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 && request.resource.data.description is string && request.resource.data.description.size() <= 500 && request.resource.data.cardCount is int && request.resource.data.cardCount >= 0 && request.resource.data.cardCount <= 150; }
    function validStudentCard() { return request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 4000 && request.resource.data.answer is string && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 8000 && request.resource.data.difficulty is string && request.resource.data.tags is list && request.resource.data.tags.size() <= 10; }
    function validDirectorate() { return request.resource.data.keys().hasOnly(['name','code','governorate','area','manager','phone','email','address','notes','active','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160 && request.resource.data.code is string && request.resource.data.code.size() <= 80 && request.resource.data.governorate is string && request.resource.data.governorate.size() > 0 && request.resource.data.governorate.size() <= 120 && request.resource.data.area is string && request.resource.data.area.size() > 0 && request.resource.data.area.size() <= 120 && request.resource.data.manager is string && request.resource.data.manager.size() <= 160 && request.resource.data.phone is string && request.resource.data.phone.size() <= 40 && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.address is string && request.resource.data.address.size() <= 300 && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000 && request.resource.data.active is bool; }
    function validSchool() { return request.resource.data.keys().hasOnly(['name','code','directorateId','directorateName','governorateName','area','type','gender','stages','manager','phone','email','address','notes','active','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.code is string && request.resource.data.code.size() <= 80 && request.resource.data.governorateName is string && request.resource.data.governorateName.size() <= 120 && request.resource.data.area is string && request.resource.data.area.size() <= 120 && request.resource.data.directorateId is string && request.resource.data.directorateId.size() > 0 && request.resource.data.directorateName is string && request.resource.data.directorateName.size() > 0 && request.resource.data.directorateName.size() <= 160 && request.resource.data.type is string && request.resource.data.type.size() <= 60 && request.resource.data.gender is string && request.resource.data.gender.size() <= 40 && request.resource.data.stages is string && request.resource.data.stages.size() <= 200 && request.resource.data.manager is string && request.resource.data.manager.size() <= 160 && request.resource.data.phone is string && request.resource.data.phone.size() <= 40 && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.address is string && request.resource.data.address.size() <= 300 && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000 && request.resource.data.active is bool; }
    function validStudentTest() { return request.resource.data.ownerId == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 && request.resource.data.questions is list && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 50 && request.resource.data.durationMinutes is number && request.resource.data.durationMinutes >= 0 && request.resource.data.durationMinutes <= 300 && request.resource.data.passingScore is number && request.resource.data.passingScore >= 0 && request.resource.data.passingScore <= 100; }
    function validStudentAiUsage() { return request.resource.data.keys().hasOnly(['count','windowStartedAt','updatedAt']) && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 3 && request.resource.data.windowStartedAt is timestamp && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time; }
    function validStudentAiUsageCreate() { return validStudentAiUsage() && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time; }
    function validStudentAiUsageUpdate() { return validStudentAiUsage() && ((request.resource.data.windowStartedAt == resource.data.windowStartedAt && request.resource.data.count == resource.data.count + 1 && request.time < resource.data.windowStartedAt + duration.value(3, 'd')) || (request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time)); }
    function validApplication() { return request.resource.data.keys().hasOnly(['studentUid','studentEmail','studentName','studentId','answers','status','reviewerUid','reviewerEmail','reviewerNote','reviewedAt','createdAt','updatedAt']) && request.resource.data.studentUid == request.auth.uid && request.resource.data.studentEmail is string && request.resource.data.studentEmail.size() <= 200 && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 100 && request.resource.data.studentId is string && request.resource.data.studentId.size() >= 4 && request.resource.data.studentId.size() <= 32 && request.resource.data.answers is map && request.resource.data.answers.keys().hasOnly(['motivation','contribution','experience','area','quality','disagreement','commitment','scenario']) && request.resource.data.answers.motivation is string && request.resource.data.answers.contribution is string && request.resource.data.answers.experience is string && request.resource.data.answers.area is string && request.resource.data.answers.quality is string && request.resource.data.answers.disagreement is string && request.resource.data.answers.commitment is string && request.resource.data.answers.scenario is string && request.resource.data.status == 'pending' && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp; }
    match /admins/{uid} { allow get: if signedIn() && (request.auth.uid == uid || superAdmin()); allow list: if superAdmin(); allow create, update: if superAdmin() && validAdminWrite(); allow delete: if false; }
    match /users/{uid} { allow get: if signedIn() && (request.auth.uid == uid || superAdmin()); allow list: if superAdmin(); allow create: if signedIn() && request.auth.uid == uid && validStudentProfile(); allow update: if signedIn() && request.auth.uid == uid && validStudentProfile() && validStudentProfileUpdate(); allow delete: if false; }
    match /studentAiUsage/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow create: if signedIn() && request.auth.uid == uid && validStudentAiUsageCreate(); allow update: if signedIn() && request.auth.uid == uid && validStudentAiUsageUpdate(); allow delete: if false; }
    match /branches/{id} { allow read: if true; allow write: if superAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if superAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /resources/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /foundations/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /solutions/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /flashcards/{id} { allow read: if contentAdmin() || resource.data.active == true; allow write: if contentAdmin(); }
    match /studentFlashcardSets/{setId} { allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid; allow update: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId; allow create: if signedIn() && validSet(); match /cards/{cardId} { allow read, update, delete: if signedIn() && get(/databases/$(database)/documents/studentFlashcardSets/$(setId)).data.ownerId == request.auth.uid; allow create: if signedIn() && get(/databases/$(database)/documents/studentFlashcardSets/$(setId)).data.ownerId == request.auth.uid && validStudentCard(); } }
    match /studentFlashcardShares/{setId} { allow read: if true; allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid; allow update: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId; allow delete: if signedIn() && resource.data.ownerId == request.auth.uid; }
    match /studentTests/{testId} { allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid; allow create: if signedIn() && validStudentTest(); allow update: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && validStudentTest(); }
    match /studentTestShares/{shareId} { allow read: if true; allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid; allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid; }
    match /curriculumUnits/{id} { allow read: if true; allow write: if contentAdmin(); }
    match /templates/{id} { allow read: if contentAdmin(); allow create, update, delete: if contentAdmin(); }
    match /sourceRegistry/{id} { allow read: if reviewer(); allow create, update, delete: if reviewer(); }
    match /tests/{id} { allow read: if resource.data.active == true || contentAdmin(); allow create, update, delete: if contentAdmin(); }
    match /suggestions/{id} { allow create: if (signedIn() || request.resource.data.contentType == 'flashcard') && request.resource.data.keys().hasOnly(['title','contentType','studentName','url','branchId','subjectId','level','foundationType','type','description','keywords','status','createdAt','updatedAt','question','answer','studentUid','studentEmail']) && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 && request.resource.data.contentType in ['resource','foundation','flashcard'] && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 80 && request.resource.data.branchId is string && request.resource.data.branchId.size() > 0 && request.resource.data.branchId.size() <= 128 && request.resource.data.subjectId is string && request.resource.data.subjectId.size() > 0 && request.resource.data.subjectId.size() <= 128 && request.resource.data.status == 'pending' && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp && (!signedIn() || ('studentUid' in request.resource.data && request.resource.data.studentUid == request.auth.uid && 'studentEmail' in request.resource.data && request.resource.data.studentEmail is string)) && (request.resource.data.contentType == 'flashcard' ? (request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 1000 && request.resource.data.answer is string && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 3000) : (request.resource.data.url is string && request.resource.data.url.size() > 0)); allow get: if (signedIn() && 'studentUid' in resource.data && resource.data.studentUid == request.auth.uid) || reviewer(); allow list: if (signedIn() && resource.data.studentUid == request.auth.uid) || reviewer(); allow update, delete: if reviewer(); }
    match /problemReports/{id} { allow create: if signedIn() && request.resource.data.keys().hasOnly(['sourceId','sourceTitle','kind','description','status','createdAt','studentUid','studentEmail']) && request.resource.data.studentUid == request.auth.uid && request.resource.data.studentEmail is string && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 2000 && request.resource.data.kind is string && request.resource.data.status == 'open' && request.resource.data.createdAt is timestamp; allow get: if (signedIn() && resource.data.studentUid == request.auth.uid) || reviewer(); allow list: if (signedIn() && resource.data.studentUid == request.auth.uid) || reviewer(); allow update, delete: if reviewer(); }
    match /adminApplications/{uid} { allow get: if signedIn() && (request.auth.uid == uid || superAdmin()); allow list: if superAdmin(); allow create: if signedIn() && request.auth.uid == uid && get(/databases/$(database)/documents/users/$(uid)).data.identityNumber is string && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(uid)).data.identityNumber && validApplication(); allow update: if superAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected' && get(/databases/$(database)/documents/users/$(uid)).data.identityNumber is string && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(uid)).data.identityNumber && validApplication()); allow delete: if false; }
    match /directorates/{id} { allow read: if true; allow create, update: if contentAdmin() && validDirectorate(); allow delete: if contentAdmin(); }
    match /schools/{id} { allow read: if true; allow create, update: if contentAdmin() && validSchool(); allow delete: if contentAdmin(); }
    match /adminLogs/{id} { allow read: if superAdmin(); allow create: if activeAdmin() && request.resource.data.adminUid == request.auth.uid && request.resource.data.role == role(); allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
