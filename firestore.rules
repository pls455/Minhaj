rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && adminDoc().data.active == true; }
    function role() { return adminDoc().data.role; }
    function isSuper() { return isAdmin() && role() == 'superadmin'; }
    function canContent() { return isAdmin() && (role() == 'superadmin' || role() == 'content_admin'); }
    function canReview() { return isAdmin() && (role() == 'superadmin' || role() == 'content_admin' || role() == 'reviewer'); }

    match /subjects/{id} {
      allow read: if true;
      allow create, update, delete: if canContent();
    }
    match /resources/{id} {
      allow read: if true;
      allow create, update, delete: if canContent();
    }
    match /foundations/{id} {
      allow read: if true;
      allow create, update, delete: if canContent();
    }
    match /suggestions/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.url is string
        && request.resource.data.title is string;
      allow read: if canReview();
      allow update: if canReview();
      allow delete: if isSuper();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isSuper();
      allow create, update, delete: if isSuper();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if canContent();
    }
  }
}
